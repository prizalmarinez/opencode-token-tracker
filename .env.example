# Path to the opencode SQLite database.
# The frontend can override this per request via the db path field.
OPENCODE_DB=~/.local/share/opencode/opencode.db

# Port for the local API server (3100 to avoid clashing with life-log's 3099).
OPCODE_SERVER_PORT=3100

# Base URL of the API server used by the frontend.
VITE_API_URL=http://localhost:3100

# skills.sh catalog base (leaderboard / search). Override to mirror or test
# against a fork; the public pages and /api/search must exist under it.
SKILLS_BASE_URL=https://skills.sh

# OpenRouter models catalog base (leaderboard). The public Models API under it
# must exist; no API key is required.
OPENROUTER_BASE_URL=https://openrouter.ai

# OpenCode Go plan usage API. The key can also be pasted in Settings (sent per
# request as X-OpenCode-Go-Key, takes precedence); without either, the usage
# cards stay hidden. OPENCODE_GO_BASE_URL only needs overriding to test
# against a mirror.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai
